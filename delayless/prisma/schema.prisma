datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Station {
  id    Int     @id @default(autoincrement())
  name  String
  code  String  @unique
  line  String
}

model Train {
  id          Int     @id @default(autoincrement())
  trainNumber String  @unique
  name        String
  line        String
}

model Schedule {
  id            Int     @id @default(autoincrement())
  delayMinutes  Int
  trainId       Int
  sourceId      Int
  destinationId Int

  train        Train   @relation(fields: [trainId], references: [id])
  source       Station @relation(fields: [sourceId], references: [id])
  destination  Station @relation(fields: [destinationId], references: [id])
}
